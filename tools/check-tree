#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
for f in scripts/*.sh sbin/* tools/lua-run; do sh -n "$f"; done
python3 - <<'__PYCHECK__'
from pathlib import Path
for p in Path('tools').glob('*.py'):
    compile(p.read_text(),str(p),'exec')
print('python syntax: OK')
__PYCHECK__
python3 - <<'__YAMLCHECK__'
from pathlib import Path
try:
    import yaml
except ImportError:
    print('workflow yaml: SKIP (PyYAML not installed)')
else:
    for p in Path('.github/workflows').glob('*.yml'):
        with p.open() as f:
            yaml.safe_load(f)
    print('workflow yaml: OK')
__YAMLCHECK__
python3 - <<'__CHECK__'
from pathlib import Path
bad=[]
for p in Path('installer').rglob('*.lua'):
    s=p.read_text()
    if '\t' in s: bad.append(f'{p}: tab character')
    if '\x00' in s: bad.append(f'{p}: NUL')
for p in Path('.').rglob('*'):
    if p.is_file() and any(x in p.parts for x in ('build','dist','__pycache__')): continue
    if p.name.endswith(('.pyc','.pyo','.o','.a','.so')): bad.append(f'binary/cache artifact: {p}')
for required in ('README.md','SECURITY.md','VERSION','installer/setup-radix.lua','scripts/build-live.sh','scripts/qemu-install-smoke.sh'):
    if not Path(required).exists(): bad.append(f'missing required file: {required}')
# Release defaults are part of the distro contract. Keep these assertions
# here so a harmless-looking refactor cannot silently point the installer at
# somebody else's channel or turn the release image back into console-only.
defaults=Path('installer/lib/defaults.lua').read_text()
for needle in (
    "M.core_repository='https://github.com/radix-gnu-linux/radix-linux'",
    "M.packages_repository='https://github.com/radix-gnu-linux/radix-packages.git'",
    "M.radix_repository='https://github.com/radix-gnu-linux/radix.git'",
    "M.desktop='kde'",
):
    if needle not in defaults: bad.append('release default missing: '+needle)
workflow=Path('.github/workflows/build-iso.yml').read_text()

# Check the release workflow semantically rather than depending on one exact
# YAML/shell formatting style. A perfectly valid multiline shell command such
# as `make iso \\n#   RADIX=... \\n#   PACKAGES=...` must satisfy the same contract as a one-line command.
import re

if not re.search(r"(?m)^\s*RADIX_REQUIRE_KDE:\s*['\"]?1['\"]?\s*$", workflow):
    bad.append("release workflow contract missing: RADIX_REQUIRE_KDE=1")

# Remove shell line continuations and collapse whitespace before checking the
# ISO command. Limit the match to a small command-sized window so unrelated
# RADIX/PACKAGES strings elsewhere in the workflow cannot satisfy it.
workflow_shell = re.sub(r"\\\s*\n\s*", " ", workflow)
workflow_shell = re.sub(r"[ \t]+", " ", workflow_shell)
iso_contract = re.compile(
    r"make\s+iso\b(?=[^\n]{0,300}\bRADIX=\.\./radix/build/radix\b)"
    r"(?=[^\n]{0,300}\bPACKAGES=\.\./radix-packages\b)[^\n]{0,300}"
)
if not iso_contract.search(workflow_shell):
    bad.append(
        "release workflow contract missing: make iso with "
        "RADIX=../radix/build/radix and PACKAGES=../radix-packages"
    )
if bad: raise SystemExit('\n'.join(bad))
print('radix-linux source shape: OK')
__CHECK__
./tools/test-activation.sh >/dev/null
if ./tools/lua-run -e 'assert(_VERSION >= "Lua 5.3")' >/dev/null 2>&1; then
  for f in installer/*.lua installer/lib/*.lua tools/*.lua; do
    ./tools/lua-run -e "assert(loadfile([[$f]]))"
  done
  ./tools/lua-run tools/test-installer.lua "$(pwd)" >/dev/null
  acct=$(mktemp -d)
  ./tools/lua-run tools/test-accounts.lua "$(pwd)" "$acct" >/dev/null
  rm -rf "$acct"
  img=$(mktemp); rm -f "$img"
  trap 'rm -f "$img"' EXIT HUP INT TERM
  ./tools/lua-run tools/test-gpt.lua "$(pwd)" "$img" >/dev/null
  python3 tools/check-gpt.py --swap=0 "$img" >/dev/null
  echo 'lua + GPT checks: OK'
else
  echo 'lua check: SKIP (install Lua 5.3+ for the full source gate)'
fi
