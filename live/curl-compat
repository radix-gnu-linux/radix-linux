#!/bin/sh
out= url= resume=0
while [ $# -gt 0 ]; do
  case "$1" in
    --output) out=$2; shift 2;;
    --continue-at) [ "${2:-}" = - ] && resume=1; shift 2;;
    https://*) url=$1; shift;;
    --*) shift; [ "${1:-}" = '=https' ] && shift || true;;
    *) shift;;
  esac
done
[ -n "$out" ] && [ -n "$url" ] || { echo 'radix curl-compat: missing URL/output' >&2; exit 2; }
if [ "$resume" -eq 1 ]; then exec wget -c -O "$out" "$url"; else exec wget -O "$out" "$url"; fi
